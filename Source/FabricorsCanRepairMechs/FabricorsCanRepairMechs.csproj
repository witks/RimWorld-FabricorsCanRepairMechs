<Project Sdk="Microsoft.NET.Sdk">
  <!-- One source, two builds:
         net472   -> 1.4/Assemblies  (RimWorld 1.4 / 1.5, Harmony 2) - references from NuGet, no game install needed
         net10.0  -> 1.7/Assemblies  (RimWorld 1.7, Harmony 3)      - references from NuGet, no game install needed
       Build both:  dotnet build -c Release
       Build one:   dotnet build -c Release -f net472 -->
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <AssemblyName>FabricorsCanRepairMechs</AssemblyName>
    <RootNamespace>FabricorsCanRepairMechs</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- RimWorld 1.4 / 1.5 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <OutputPath>../../1.4/Assemblies/</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.4.3901" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.2.2" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- RimWorld 1.7 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputPath>../../1.7/Assemblies/</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.5011-unstable" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.5" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
